---
---

<section class="work" id="work">
  <div class="work-inner">
    <p class="eyebrow">Selected Work</p>
    <h2>Recent projects</h2>
    <p class="lead">
      A few examples of the kind of websites I build — more to come as this
      portfolio grows.
    </p>

    <div class="cards">
      <article class="card">
        <p class="tag">WordPress + LMS</p>
        <h3>Islamic Academy Website</h3>
        <p>
          Online Islamic academy with courses and live classes, built for
          students at home and abroad.
        </p>
      </article>

      <article class="card">
        <p class="tag">WordPress + Local SEO</p>
        <h3>Local Business Website</h3>
        <p>
          Fast, simple website for a local business — built to be found on
          Google by nearby customers.
        </p>
      </article>

      <article class="card">
        <p class="tag">Tutor LMS</p>
        <h3>Online Course Platform</h3>
        <p>
          Full course platform with lessons, students and enrolments, easy
          for the owner to manage.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .work {
    background: #0a0a2e;
    color: #ffffff;
  }

  .work-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #ff2e88;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .lead {
    max-width: 560px;
    margin: 16px 0 0;
    color: #c9c9e6;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .card {
    padding: 32px 28px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    background: #14143a;
  }

  .tag {
    display: inline-block;
    margin: 0 0 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 46, 136, 0.15);
    color: #ff2e88;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .card h3 {
    margin: 0 0 10px;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .card p:last-child {
    margin: 0;
    color: #c9c9e6;
    line-height: 1.7;
  }

  @media (max-width: 820px) {
    .work-inner {
      padding: 56px 24px;
    }

    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
