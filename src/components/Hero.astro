---
---
<section class="hero">
  <span class="deco deco-circle" aria-hidden="true"></span>
  <span class="deco deco-plus" aria-hidden="true">+</span>
  <span class="deco deco-zigzag" aria-hidden="true">〰</span>
  <span class="deco deco-ring" aria-hidden="true"></span>

  <div class="hero-inner">
    <div class="hero-text">
      <p class="hello">Hi There!</p>
      <h1>
        My Name<br />
        is <span class="name">Muhammad Bashir</span>
      </h1>
      <p class="role">
        <span class="role-pink">Web Designer</span>
        <span class="role-italic">&amp; Developer.</span>
      </p>
      <p class="intro">
        I design and build WordPress websites, LMS platforms and
        SEO-friendly sites for Islamic institutions, scholars and small
        businesses.
      </p>
      <div class="actions">
        <a class="btn btn-pink" href="#work">View My Work</a>
        <a class="btn btn-ghost" href="#contact">Contact Me</a>
      </div>
    </div>

    <div class="hero-photo">
      <img
        src="/images/portrait.png"
        alt="Muhammad Bashir — portrait"
        width="1024"
        height="1536"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #0a0a2e;
    color: #ffffff;
    min-height: 100vh;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 24px 0;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: end;
  }

  .hello {
    display: inline-block;
    margin: 0 0 24px;
    padding: 10px 18px;
    border: 1.5px solid #ff2e88;
    border-radius: 999px;
    color: #ff2e88;
    font-weight: 600;
    letter-spacing: 0.02em;
    transform: rotate(-4deg);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .name {
    color: #ffffff;
  }

  .role {
    margin: 18px 0 0;
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    line-height: 1.1;
    font-weight: 800;
  }

  .role-pink {
    color: #ff2e88;
  }

  .role-italic {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 500;
  }

  .intro {
    max-width: 520px;
    margin: 24px 0 0;
    color: #c9c9e6;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 32px 0 72px;
  }

  .btn {
    display: inline-block;
    padding: 14px 26px;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
  }

  .btn-pink {
    background: #ff2e88;
    color: #ffffff;
  }

  .btn-ghost {
    border: 1.5px solid #ffffff;
    color: #ffffff;
  }

  .hero-photo {
    display: flex;
    justify-content: flex-end;
  }

  .hero-photo img {
    display: block;
    width: min(100%, 480px);
    height: 560px;
    object-fit: cover;
    object-position: top center;
    border-radius: 24px 24px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .deco {
    position: absolute;
    z-index: 1;
    color: #ff2e88;
    opacity: 0.7;
  }

  .deco-circle {
    width: 26px;
    height: 26px;
    border: 1.5px solid #ffffff;
    border-radius: 50%;
    opacity: 0.35;
    top: 18%;
    left: 6%;
  }

  .deco-plus {
    top: 58%;
    left: 3%;
    font-size: 1.6rem;
  }

  .deco-zigzag {
    top: 34%;
    right: 6%;
    font-size: 1.4rem;
    letter-spacing: 0.2em;
  }

  .deco-ring {
    width: 22px;
    height: 22px;
    border: 1.5px solid #ffffff;
    border-radius: 50%;
    opacity: 0.35;
    right: 5%;
    bottom: 12%;
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 40px;
    }

    .actions {
      margin-bottom: 8px;
    }

    .hero-photo {
      justify-content: center;
    }

    .hero-photo img {
      height: 440px;
    }
  }
</style>
